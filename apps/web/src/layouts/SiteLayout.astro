---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '大学生光电科技协会 · Photoelectric Technology',
} = Astro.props;

const baseRaw = import.meta.env.BASE_URL;
const base = baseRaw.endsWith('/') ? baseRaw : `${baseRaw}/`;
const asset = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const route = (path: string) => asset(path);
const fullTitle = `${title} · 光电科技`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F1428" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@300;400;500&family=Noto+Serif+SC:wght@400;500;600&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
  </head>
  <body class="site-shell">
    <header class="site-header">
      <a class="site-brand" href={route('/') } aria-label="返回首页">
        <img src={asset('logo.jpg')} alt="光电科技 Logo" width="48" height="48" />
        <span>
          <strong>光电科技</strong>
          <small>Photoelectric Technology</small>
        </span>
      </a>
      <nav aria-label="主导航">
        <a href={route('/team')}>团队</a>
        <a href={route('/projects')}>项目</a>
        <a href={route('/devices')}>设备</a>
        <a href={route('/items')}>资产</a>
        <a class="site-nav-cta" href={route('/recruit')}>加入我们</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <p class="site-footer-kicker">PHOTOELECTRIC TECHNOLOGY</p>
        <p>大学生光电科技协会。<br />致力于嵌入式开发、计算机视觉、机器人操作与创客实践。</p>
      </div>
      <div>
        <p class="site-footer-kicker">EXPLORE</p>
        <nav aria-label="页脚导航">
          <a href={route('/')}>首页</a>
          <a href={route('/team')}>团队</a>
          <a href={route('/projects')}>项目</a>
          <a href={route('/recruit')}>招新</a>
        </nav>
      </div>
      <div>
        <p class="site-footer-kicker">STATUS</p>
        <p>公开展示站<br />内部资料请通过协会内部渠道访问。</p>
      </div>
      <div class="site-footer-bottom">
        <span>© 2016—2026 光电科技</span>
        <span>Photoelectric Technology</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --site-night: #0F1428;
    --site-night-soft: #181E32;
    --site-ink: #E6ECF5;
    --site-muted: #A8B4C8;
    --site-faint: #6B7896;
    --site-blue: #4288C9;
    --site-blue-hi: #BED6F8;
    --site-line: rgba(190, 214, 248, 0.16);
  }

  * { box-sizing: border-box; }
  html { background: var(--site-night); color-scheme: dark; }
  body.site-shell {
    min-width: 320px;
    margin: 0;
    color: var(--site-ink);
    background:
      linear-gradient(rgba(190, 214, 248, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(190, 214, 248, 0.025) 1px, transparent 1px),
      var(--site-night);
    background-size: 48px 48px;
    font-family: 'Noto Sans SC', sans-serif;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 82px;
    padding: 1rem clamp(1rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--site-line);
    background: rgba(15, 20, 40, 0.9);
    backdrop-filter: blur(18px);
  }
  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--site-ink);
    text-decoration: none;
  }
  .site-brand img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(190, 214, 248, 0.35);
  }
  .site-brand span { display: grid; gap: 0.18rem; }
  .site-brand strong {
    font: 500 1.05rem 'Noto Serif SC', serif;
    letter-spacing: 0.08em;
  }
  .site-brand small {
    color: var(--site-muted);
    font: 0.62rem 'JetBrains Mono', monospace;
    letter-spacing: 0.08em;
  }
  .site-header nav, .site-footer nav { display: flex; align-items: center; gap: 0.35rem; }
  .site-header nav a, .site-footer nav a {
    padding: 0.65rem 0.75rem;
    color: var(--site-muted);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 180ms ease, background 180ms ease;
  }
  .site-header nav a:hover, .site-footer nav a:hover { color: var(--site-ink); }
  .site-nav-cta {
    margin-left: 0.55rem;
    color: var(--site-night) !important;
    background: var(--site-blue-hi);
  }
  .site-nav-cta:hover { background: #fff !important; }

  .page-wrap { width: min(1120px, calc(100% - 2rem)); margin: 0 auto; }
  .page-hero {
    min-height: 46vh;
    display: grid;
    align-content: end;
    padding: clamp(5rem, 13vw, 10rem) 0 5rem;
    border-bottom: 1px solid var(--site-line);
  }
  .page-index {
    display: block;
    color: var(--site-blue-hi);
    font: 0.7rem 'JetBrains Mono', monospace;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .page-hero h1 {
    max-width: 760px;
    margin: 1.2rem 0;
    color: var(--site-ink);
    font: 500 clamp(3rem, 8vw, 6.5rem)/1.05 'Noto Serif SC', serif;
    letter-spacing: -0.045em;
  }
  .page-hero p { max-width: 620px; margin: 0; color: var(--site-muted); line-height: 1.9; }
  .page-section { padding: clamp(4rem, 9vw, 8rem) 0; }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--site-line);
    padding-bottom: 1.25rem;
  }
  .section-heading h2 { margin: 0; font: 500 clamp(1.8rem, 4vw, 3rem) 'Noto Serif SC', serif; }
  .section-heading p { margin: 0; color: var(--site-faint); font: 0.7rem 'JetBrains Mono', monospace; letter-spacing: 0.15em; }
  .site-footer {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 3rem;
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 4rem 0 1rem;
    border-top: 1px solid var(--site-line);
    color: var(--site-muted);
    font-size: 0.8rem;
    line-height: 1.9;
  }
  .site-footer p { margin: 0; }
  .site-footer-kicker { margin-bottom: 0.9rem !important; color: var(--site-blue-hi); font: 0.65rem 'JetBrains Mono', monospace; letter-spacing: 0.15em; }
  .site-footer nav { align-items: start; flex-direction: column; gap: 0; }
  .site-footer nav a { padding: 0; }
  .site-footer-bottom { grid-column: 1 / -1; display: flex; justify-content: space-between; gap: 1rem; margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--site-line); color: var(--site-faint); font: 0.65rem 'JetBrains Mono', monospace; }

  @media (max-width: 700px) {
    .site-header { align-items: flex-start; flex-direction: column; gap: 0.6rem; padding-top: 0.8rem; padding-bottom: 0.8rem; }
    .site-header nav { width: 100%; justify-content: space-between; gap: 0; }
    .site-header nav a { padding: 0.45rem 0.35rem; font-size: 0.68rem; }
    .site-nav-cta { margin-left: 0 !important; }
    .page-hero { min-height: 42vh; padding-top: 4rem; }
    .site-footer { grid-template-columns: 1fr 1fr; gap: 2rem 1rem; }
    .site-footer > :first-child { grid-column: 1 / -1; }
    .site-footer-bottom { flex-direction: column; }
  }
</style>
