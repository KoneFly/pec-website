---
interface Props {
  index: string;
  title: string;
  english: string;
  description: string;
}

const { index, title, english, description } = Astro.props;
---

<article class="info-row">
  <span class="info-index">{index}</span>
  <div class="info-title">
    <h3>{title}</h3>
    <span>{english}</span>
  </div>
  <p>{description}</p>
</article>

<style>
  .info-row { display: grid; grid-template-columns: 4rem minmax(180px, 0.8fr) 1.3fr; gap: 2rem; align-items: start; padding: 1.6rem 0; border-bottom: 1px solid var(--site-line); }
  .info-row:hover .info-index { color: var(--site-blue-hi); }
  .info-index { color: var(--site-faint); font: 0.75rem 'JetBrains Mono', monospace; transition: color 180ms ease; }
  .info-title h3 { margin: 0 0 0.4rem; font: 500 1.25rem 'Noto Serif SC', serif; }
  .info-title span { color: var(--site-blue-hi); font: 0.66rem 'JetBrains Mono', monospace; letter-spacing: 0.08em; }
  .info-row p { margin: 0; color: var(--site-muted); line-height: 1.8; }
  @media (max-width: 700px) { .info-row { grid-template-columns: 2.5rem 1fr; gap: 0.75rem; } .info-row p { grid-column: 2; } }
</style>
